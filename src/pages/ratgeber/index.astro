---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { crumbs, abs } from '../../lib/schema';
const posts = (await getCollection('ratgeber')).sort((a, b) => +b.data.datum - +a.data.datum);
const list = { '@context': 'https://schema.org', '@type': 'Blog', name: 'Ratgeber – Wien West Sticker', url: abs('/ratgeber/', Astro.site),
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.titel, url: abs(`/ratgeber/${p.id}/`, Astro.site), datePublished: p.data.datum.toISOString().slice(0, 10) })) };
---
<Base title="Ratgeber: Sticker kleben, Kurvenkultur & Derby | Wien West Sticker" description="Tipps zum richtigen Kleben, Hintergründe zur Stickerkultur in der Fankurve und Bedeutung von Sprüchen wie Anti Viola." jsonld={[list, crumbs(Astro.site, [['Start', '/'], ['Ratgeber', '/ratgeber/']])]}>
  <div class="wrap" style="padding-bottom:60px">
    <nav class="crumbs"><a href="/">Start</a> / Ratgeber</nav>
    <h1 style="margin-top:20px">Ratgeber</h1>
    <div class="grid" style="margin-top:20px">
      {posts.map((p) => (
        <article class="card">
          {p.data.bild && <div class="img"><img src={p.data.bild} alt="" width="300" height="200" loading="lazy" /></div>}
          <h3><a href={`/ratgeber/${p.id}/`}>{p.data.titel}</a></h3>
          <p class="meta">{p.data.beschreibung}</p>
        </article>
      ))}
    </div>
  </div>
</Base>
