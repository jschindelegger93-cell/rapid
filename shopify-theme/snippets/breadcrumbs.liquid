{%- comment -%} Sichtbare Brotkrumen + BreadcrumbList. Parameter: crumbs (Array aus "Titel|URL") {%- endcomment -%}
{%- assign items = crumbs | split: '§§' -%}
<nav class="crumbs" aria-label="Brotkrumen">
  {%- for c in items -%}
    {%- assign parts = c | split: '|' -%}
    {%- if forloop.last -%}<span aria-current="page">{{ parts[0] }}</span>{%- else -%}<a href="{{ parts[1] }}">{{ parts[0] }}</a> / {% endif -%}
  {%- endfor -%}
</nav>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
{%- for c in items -%}{%- assign parts = c | split: '|' -%}
{"@type":"ListItem","position":{{ forloop.index }},"name":{{ parts[0] | json }},"item":{{ shop.url | append: parts[1] | json }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}]}
</script>
