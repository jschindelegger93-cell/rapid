<!doctype html>
<html lang="de-AT">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} – bald da</title>
  <meta name="robots" content="noindex">
  <style>
    @font-face { font-family: 'Anton'; src: url('{{ 'anton.woff2' | asset_url }}') format('woff2'); font-display: swap; }
    @font-face { font-family: 'Inter Variable'; src: url('{{ 'inter.woff2' | asset_url }}') format('woff2'); font-weight: 100 900; font-display: swap; }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main id="main">{{ content_for_layout }}</main>
</body>
</html>
