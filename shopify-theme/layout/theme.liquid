<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'de' }}-AT">
<head>
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-W4T3DBCC');</script>
  <!-- End Google Tag Manager -->
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#111111">
  <meta name="msvalidate.01" content="4DDD3DCA0D2C273BA77807C30B8942D4">
  <meta name="format-detection" content="telephone=no,date=no,address=no,email=no">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="icon" type="image/png" sizes="192x192" href="{{ 'favicon-192.png' | asset_url }}">
  <link rel="icon" type="image/png" sizes="96x96" href="{{ 'favicon-96.png' | asset_url }}">
  <link rel="icon" type="image/png" sizes="48x48" href="{{ 'favicon-48.png' | asset_url }}">
  <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
  <link rel="shortcut icon" href="{{ 'favicon-48.png' | asset_url }}">
  <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
  {%- render 'meta-tags' -%}
  <link rel="preload" href="{{ 'anton.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ 'inter.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  <style>
    @font-face { font-family: 'Anton'; src: url('{{ 'anton.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-display: swap; }
    @font-face { font-family: 'Inter Variable'; src: url('{{ 'inter.woff2' | asset_url }}') format('woff2'); font-weight: 100 900; font-display: swap; }
    :root { --g: {{ settings.color_green }}; --g-d: {{ settings.color_green_dark }}; --k: {{ settings.color_black }}; --paper: {{ settings.color_paper }}; }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}
  <style>
    /* Mobile-Menü: .hd hat backdrop-filter -> fixed-Kind wird relativ zum Header positioniert. Daher absolute unter dem Header. */
    @media (max-width: 860px) {
      .hd .nav { position: absolute; inset: auto; top: 100%; left: 0; right: 0; height: calc(100vh - 72px); height: calc(100dvh - 72px); overflow-y: auto; z-index: 45; margin: 0; border-top: 1px solid var(--line); padding: 24px var(--gut) calc(24px + env(safe-area-inset-bottom)); background: var(--paper); }
    }
  </style>
  {%- render 'schema-org' -%}
  {{ content_for_header }}
</head>
<body class="t-{{ template.name }}">
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W4T3DBCC" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <a class="skip" href="#main">Zum Inhalt</a>
  {% sections 'header-group' %}
  <main id="main" role="main">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {% section 'cart-drawer' %}
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>
    window.WW = {
      routes: { cart: '{{ routes.cart_url }}', add: '{{ routes.cart_add_url }}', change: '{{ routes.cart_change_url }}', root: '{{ routes.root_url }}' },
      mbw: {{ settings.mbw | times: 100 }},
      drawer: {{ settings.cart_type_drawer | json }},
      t: { added: 'im Warenkorb', error: 'Das hat nicht geklappt. Bitte nochmal versuchen.' }
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
