{%- assign c = section.settings.collection -%}
<section class="section">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <div class="head-row"><h2>{{ section.settings.heading }}</h2>{% if c != blank %}<a href="{{ c.url }}" class="more">{{ section.settings.link_label }}</a>{% endif %}</div>
    <div class="grid">
      {%- if c != blank -%}
        {%- assign shown = 0 -%}
        {%- for product in c.products -%}
          {%- if section.settings.only_singles and product.type != 'Sticker' -%}{%- continue -%}{%- endif -%}
          {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
          {%- render 'product-card', product: product -%}
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Produkt-Raster",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Bestseller" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Was im Block am meisten klebt" },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "limit", "label": "Anzahl", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "only_singles", "label": "Nur Einzelsticker", "default": true },
    { "type": "text", "id": "link_label", "label": "Link-Text", "default": "Alle Sticker →" }
  ],
  "presets": [{ "name": "Produkt-Raster" }]
}
{% endschema %}
