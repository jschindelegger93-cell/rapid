<section class="section seo-txt" style="{% if section.settings.no_top %}padding-top:0{% endif %}">
  <div class="wrap prose rte">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {{ section.settings.text }}
  </div>
</section>
{% schema %}
{
  "name": "Text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "no_top", "label": "Kein Abstand oben", "default": true }
  ],
  "presets": [{ "name": "Text" }]
}
{% endschema %}
