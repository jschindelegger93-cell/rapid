<section class="section">
  <div class="wrap">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <div class="cats">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a href="{{ c.url | default: '/collections/all' }}" {{ block.shopify_attributes }}><b>{{ block.settings.title | default: c.title }}</b><span>{{ block.settings.text }}</span></a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Kategorie-Kacheln",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Kategorien" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Wo soll's kleben?" }
  ],
  "max_blocks": 9,
  "blocks": [{ "type": "tile", "name": "Kachel", "settings": [
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "text", "id": "title", "label": "Titel" },
    { "type": "text", "id": "text", "label": "Text" }
  ] }],
  "presets": [{ "name": "Kategorie-Kacheln" }]
}
{% endschema %}
