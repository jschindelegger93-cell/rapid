<section class="section dark">
  <div class="wrap">
    <span class="eyebrow" style="color:#7bd99b">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <div class="lead" style="color:#bbb">{{ section.settings.text }}</div>
    <div class="packs">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p == blank -%}{%- continue -%}{%- endif -%}
        {%- assign v = p.selected_or_first_available_variant -%}
        {%- assign stueck = v.compare_at_price | divided_by: 350 | at_least: 1 -%}
        <div class="pack{% if block.settings.highlight %} top{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.highlight -%}<span class="tag">Beliebteste Wahl</span>{%- endif -%}
          {{ p.featured_image | image_url: width: 360 | image_tag: width: 180, height: 180, loading: 'lazy', alt: p.title }}
          <h3>{{ p.title }}</h3>
          <p class="pp">{{ v.price | money }}{% if v.compare_at_price > v.price %} <s>{{ v.compare_at_price | money }}</s>{% endif %}</p>
          <p class="per">{{ v.price | divided_by: stueck | money }} pro Sticker</p>
          <form method="post" action="{{ routes.cart_add_url }}" data-add-form style="width:100%;margin-top:auto">
            <input type="hidden" name="id" value="{{ v.id }}"><input type="hidden" name="quantity" value="1">
            <button class="btn {% if block.settings.highlight %}btn--g{% else %}btn--o{% endif %}" style="width:100%;{% unless block.settings.highlight %}color:#fff;border-color:#fff{% endunless %}" type="submit">In den Warenkorb</button>
          </form>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.link != blank -%}<p style="text-align:center;margin-top:28px"><a href="{{ section.settings.link }}" style="color:#fff">{{ section.settings.link_label }}</a></p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Packs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Packs" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Für die Auswärtsfahrt eingepackt" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Ein Kuvert, viele Motive – zum Aufteilen im Bus, im Zug oder am Stammtisch.</p>" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link-Text", "default": "Alle Packs →" }
  ],
  "max_blocks": 3,
  "blocks": [{ "type": "pack", "name": "Pack", "settings": [
    { "type": "product", "id": "product", "label": "Pack" },
    { "type": "checkbox", "id": "highlight", "label": "Hervorheben", "default": false }
  ] }],
  "presets": [{ "name": "Packs" }]
}
{% endschema %}
