<section class="section kultur">
  <div class="wrap kultur-in">
    <div>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <div class="lead">{{ section.settings.lead }}</div>
      {{ section.settings.text }}
    </div>
    <ul class="werte">
      {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></li>{%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "Kurvenkultur",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Kurvenkultur" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Sticker gehören zur Kurve" },
    { "type": "richtext", "id": "lead", "label": "Lead" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "max_blocks": 6,
  "blocks": [{ "type": "wert", "name": "Wert", "settings": [
    { "type": "text", "id": "title", "label": "Titel" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ] }],
  "presets": [{ "name": "Kurvenkultur" }]
}
{% endschema %}
