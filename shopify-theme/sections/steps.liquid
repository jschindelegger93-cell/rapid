<section class="section steps-s">
  <div class="wrap">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <ol class="steps">
      {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b>{{ block.settings.text }}<em>{{ block.settings.time }}</em></li>{%- endfor -%}
    </ol>
  </div>
</section>
{% schema %}
{
  "name": "Ablauf",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "So läuft's" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Bestellt, verschickt, geklebt" }
  ],
  "max_blocks": 4,
  "blocks": [{ "type": "step", "name": "Schritt", "settings": [
    { "type": "text", "id": "title", "label": "Titel" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "time", "label": "Dauer" }
  ] }],
  "presets": [{ "name": "Ablauf" }]
}
{% endschema %}
