<div class="wrap" style="min-height:100vh;display:grid;place-items:center;text-align:center">
  <div>
    <h1>Wien West Sticker</h1>
    <p class="lead" style="margin:0 auto 24px">{{ shop.password_message | default: 'Wir kleben gerade die letzten Sticker. Bald geht’s los.' }}</p>
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <label class="visually-hidden" for="pw">Passwort</label>
      <div class="search-form" style="max-width:420px;margin:0 auto"><input id="pw" type="password" name="password" placeholder="Passwort"><button class="btn btn--g" type="submit">Rein</button></div>
    {%- endform -%}
  </div>
</div>
{% schema %}{ "name": "Passwort" }{% endschema %}
