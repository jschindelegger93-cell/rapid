<section class="section" style="padding-top:0">
  <div class="wrap" style="max-width:860px">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}><summary>{{ block.settings.q }}</summary><div class="rte">{{ block.settings.a }}</div></details>
    {%- endfor -%}
    {%- if section.settings.link != blank -%}<p style="margin-top:24px"><a href="{{ section.settings.link }}">Alle Fragen →</a></p>{%- endif -%}
  </div>
</section>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
{%- for block in section.blocks -%}{"@type":"Question","name":{{ block.settings.q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.a | strip_html | json }}}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
</script>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Kurz gefragt" },
    { "type": "url", "id": "link", "label": "Link zu allen Fragen" }
  ],
  "blocks": [{ "type": "qa", "name": "Frage", "settings": [
    { "type": "text", "id": "q", "label": "Frage" },
    { "type": "richtext", "id": "a", "label": "Antwort" }
  ] }],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
