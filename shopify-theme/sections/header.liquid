<header class="hd">
  <div class="wrap">
    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} – Startseite">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 160 | image_tag: height: 40, alt: shop.name, loading: 'eager' }}
      {%- else -%}<i>WW</i>{{ section.settings.wordmark }}{%- endif -%}
    </a>
    <nav class="nav" id="nav" aria-label="Hauptmenü">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    <a class="hd-search" href="{{ routes.search_url }}" aria-label="Suche">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    </a>
    <button class="burger" aria-label="Menü" aria-expanded="false" aria-controls="nav" id="burger">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <a class="cart-btn" href="{{ routes.cart_url }}" data-open-cart aria-label="Warenkorb öffnen">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
      <span class="n" data-cart-count>{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span>
    </a>
  </div>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (optional)" },
    { "type": "text", "id": "wordmark", "label": "Wortmarke", "default": "Wien West" },
    { "type": "link_list", "id": "menu", "label": "Menü", "default": "main-menu" }
  ]
}
{% endschema %}
