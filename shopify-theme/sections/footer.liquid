<footer class="ft">
  <div class="wrap">
    <div class="cols">
      <div>
        <a class="logo" href="{{ routes.root_url }}" style="color:#fff"><i>WW</i>Wien West</a>
        <p style="margin-top:16px">{{ section.settings.about }}</p>
        <p style="font-size:13px;color:#8d8d8d">{{ section.settings.disclaimer }}</p>
      </div>
      {%- for m in (1..3) -%}
        {%- assign key = 'menu_' | append: m -%}
        {%- assign menu = section.settings[key] -%}
        {%- if menu != blank -%}
        <div><h4>{{ menu.title }}</h4><ul>
          {%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
          {%- if forloop.last -%}<li><button type="button" class="cookie-link" data-cookie-prefs>Cookie-Einstellungen</button></li>{%- endif -%}
        </ul></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="legal">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <span>Alle Preise inkl. MwSt., zzgl. <a href="{{ section.settings.shipping_url | default: '/pages/versand-zahlung' }}">Versand</a></span>
      {%- if shop.enabled_payment_types.size > 0 -%}
      <span class="pay" aria-label="Zahlungsarten">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'pay-icon' }}{% endfor %}</span>
      {%- endif -%}
    </div>
  </div>
</footer>
<style>.pay { display: flex; gap: 6px; flex-wrap: wrap; } .pay-icon { width: 38px; height: 24px; }</style>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "about", "label": "Text", "default": "Grün-Weiß Sticker von Fans aus Wien West. Für den Block, die Auswärtsfahrt und alles dazwischen. Gratis Versand ab 20 € (AT/DE)." },
    { "type": "textarea", "id": "disclaimer", "label": "Hinweis", "default": "Inoffizieller Fanartikel. Kein Produkt des SK Rapid Wien, keine Vereins- oder Fangruppen-Logos." },
    { "type": "link_list", "id": "menu_1", "label": "Menü 1", "default": "footer" },
    { "type": "link_list", "id": "menu_2", "label": "Menü 2" },
    { "type": "link_list", "id": "menu_3", "label": "Menü 3" },
    { "type": "url", "id": "shipping_url", "label": "Link Versandseite" }
  ]
}
{% endschema %}
