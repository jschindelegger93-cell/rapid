{%- liquid
  assign v = product.selected_or_first_available_variant
  assign is_pack = false
  if product.type == 'Sticker-Pack'
    assign is_pack = true
  endif
  assign stueck = 1
  if is_pack and v.compare_at_price > 0
    assign stueck = v.compare_at_price | divided_by: 290
  endif
  assign cat = blank
  for c in product.collections
    if c.handle == 'anti-viola-sticker' or c.handle == 'forza-rapid-sticker' or c.handle == 'wien-west-huetteldorf-sticker' or c.handle == 'ultras-sticker' or c.handle == 'sticker-packs'
      assign cat = c
      break
    endif
  endfor
  assign free_cents = settings.free_shipping | times: 100
  capture crumbs
    echo 'Start|/§§Alle Sticker|/collections/alle-sticker'
    if cat != blank
      echo '§§' | append: cat.title | append: '|' | append: cat.url
    endif
    echo '§§' | append: product.title | append: '|' | append: product.url
  endcapture
-%}
<div class="wrap">
  {% render 'breadcrumbs', crumbs: crumbs %}
  <div class="pdp">
    <div>
      <div class="stage">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 1000 | image_tag: widths: '400,600,800,1000', sizes: '(max-width: 860px) 90vw, 560px', loading: 'eager', fetchpriority: 'high', alt: product.featured_image.alt | default: product.title }}
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
      <div class="pdp-thumbs">{%- for img in product.images offset: 1 -%}{{ img | image_url: width: 160 | image_tag: loading: 'lazy', alt: img.alt | default: product.title }}{%- endfor -%}</div>
      {%- endif -%}
    </div>
    <div class="info">
      <span class="eyebrow">{% if cat != blank %}{{ cat.title }}{% else %}{{ product.type }}{% endif %}{% if product.tags contains 'bestseller' %} · Bestseller{% endif %}</span>
      <h1>{{ product.title }}</h1>
      <p class="p">{{ v.price | money }}{% if v.compare_at_price > v.price %}<s>{{ v.compare_at_price | money }}</s>{% endif %}</p>
      <p class="vat">inkl. MwSt., zzgl. <a href="/pages/versand-zahlung">Versand</a> · {% if is_pack %}{{ stueck }} Stück · {{ v.price | divided_by: stueck | money }} pro Sticker{% else %}ca. 9 × 6 cm{% endif %}</p>
      {%- unless is_pack -%}<p class="hint"><b>Mix-Rabatt</b> – Motive frei kombinieren: {% render 'mix-tiers' %}. <a href="{{ settings.mix_url | default: '/pages/mix' }}">Mix zusammenstellen →</a></p>{%- endunless -%}
      {%- form 'product', product, data-add-form: 'true', class: 'buy-form' -%}
        <input type="hidden" name="id" value="{{ v.id }}">
        <div class="buy">
          <label class="q"><span class="sr">Menge</span><input type="number" name="quantity" min="1" max="99" value="1" inputmode="numeric"></label>
          <button class="btn btn--g" type="submit" {% unless v.available %}disabled{% endunless %}>{% if v.available %}In den Warenkorb{% else %}Ausverkauft{% endif %}</button>
        </div>
      {%- endform -%}
      <div class="ship" style="margin:18px 0">
        {%- assign missing = free_cents | minus: cart.total_price -%}
        {%- if missing > 0 -%}Noch <b>{{ missing | money }}</b> bis zum Gratis-Versand (AT/DE){%- else -%}✓ Gratis-Versand (AT/DE){%- endif -%}
      </div>
      <ul class="facts">
        {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endfor -%}
      </ul>
      <div class="txt rte">{{ product.description }}</div>
      <table class="spec">
        <tr><th>Format</th><td>{% if is_pack %}{{ stueck }} × ca. 9 × 6 cm{% else %}ca. 9 × 6 cm{% endif %}</td></tr>
        <tr><th>Material</th><td>Vinyl, matt laminiert, wetterfest</td></tr>
        {%- if cat != blank -%}<tr><th>Kategorie</th><td><a href="{{ cat.url }}">{{ cat.title }}</a></td></tr>{%- endif -%}
        {%- if v.sku != blank -%}<tr><th>Artikelnummer</th><td>{{ v.sku }}</td></tr>{%- endif -%}
      </table>
      <p class="vat" style="margin-top:20px">Inoffizieller Fanartikel – eigenes Design, kein Produkt des SK Rapid Wien.</p>
    </div>
  </div>
</div>
<div class="sticky-buy">
  <span class="price">{{ v.price | money }}</span>
  <form method="post" action="{{ routes.cart_add_url }}" data-add-form>
    <input type="hidden" name="id" value="{{ v.id }}"><input type="hidden" name="quantity" value="1">
    <button class="btn btn--g btn--sm" type="submit" {% unless v.available %}disabled{% endunless %}>In den Warenkorb</button>
  </form>
</div>
{%- comment -%} Product JSON-LD {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "{{ shop.url }}{{ product.url }}#product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | strip_newlines | truncate: 500 | json }},
  "sku": {{ v.sku | json }},
  "mpn": {{ v.sku | json }},
  "category": {{ cat.title | default: product.type | json }},
  "image": [{% for img in product.images limit: 3 %}{{ img | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "material": "Vinyl, matt laminiert",
  "width": { "@type": "QuantitativeValue", "value": 90, "unitCode": "MMT" },
  "height": { "@type": "QuantitativeValue", "value": 60, "unitCode": "MMT" },
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ v.price | divided_by: 100.0 | round: 2 }}",
    "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-12-31' }}",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
    "seller": { "@id": "{{ shop.url }}/#organization" },
    "shippingDetails": [
      {%- assign price_cents = v.price -%}
      {"@type":"OfferShippingDetails","shippingRate":{"@type":"MonetaryAmount","value":"{% if price_cents >= free_cents %}0{% else %}3.50{% endif %}","currency":"EUR"},"shippingDestination":{"@type":"DefinedRegion","addressCountry":"AT"},"deliveryTime":{"@type":"ShippingDeliveryTime","handlingTime":{"@type":"QuantitativeValue","minValue":0,"maxValue":2,"unitCode":"DAY"},"transitTime":{"@type":"QuantitativeValue","minValue":1,"maxValue":2,"unitCode":"DAY"}}},
      {"@type":"OfferShippingDetails","shippingRate":{"@type":"MonetaryAmount","value":"{% if price_cents >= free_cents %}0{% else %}4.90{% endif %}","currency":"EUR"},"shippingDestination":{"@type":"DefinedRegion","addressCountry":"DE"},"deliveryTime":{"@type":"ShippingDeliveryTime","handlingTime":{"@type":"QuantitativeValue","minValue":0,"maxValue":2,"unitCode":"DAY"},"transitTime":{"@type":"QuantitativeValue","minValue":2,"maxValue":3,"unitCode":"DAY"}}}
    ],
    "hasMerchantReturnPolicy": { "@type": "MerchantReturnPolicy", "applicableCountry": ["AT","DE"], "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow", "merchantReturnDays": 14, "returnMethod": "https://schema.org/ReturnByMail", "returnFees": "https://schema.org/ReturnShippingFees" }
  }
}
</script>
{% schema %}
{
  "name": "Produkt",
  "blocks": [{ "type": "fact", "name": "Vorteil", "settings": [{ "type": "text", "id": "text", "label": "Text" }] }],
  "max_blocks": 6
}
{% endschema %}
