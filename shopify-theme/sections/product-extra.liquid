{%- liquid
  assign t = product.title | remove: ' Schal-Sticker' | remove: ' Sticker'
  assign imgs = product.metafields.custom.lifestyle_images.value
  assign story = product.metafields.custom.story.value
  assign is_mystery = false
  if product.handle contains 'mystery'
    assign is_mystery = true
  endif
  assign mystery = all_products['mystery-pack-15er']
  assign base = 350
-%}
<style>
  .px-sec{padding:56px 0 8px}
  .px-sec h2{margin:0 0 14px}
  .px-intro{display:grid;grid-template-columns:minmax(0,560px) 1fr;gap:44px;align-items:start}
  .px-intro.noimg{grid-template-columns:1fr;max-width:760px}
  .px-pics{display:grid;gap:10px}
  .px-pics figure{margin:0;border-radius:var(--r,14px);overflow:hidden;background:#111;position:relative}
  .px-pics img{width:100%;height:auto;display:block}
  .px-pics figcaption{position:absolute;left:10px;bottom:10px;background:rgba(0,0,0,.6);color:#fff;font-size:12px;padding:4px 10px;border-radius:999px}
  .px-pics .row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .px-ticks{list-style:none;padding:0;margin:18px 0 0;display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .px-ticks li{background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:12px;padding:12px 14px;font-size:15px}
  .px-ticks li b{display:block;color:#00753d;font-size:13px;letter-spacing:1px;text-transform:uppercase;margin-bottom:2px}
  .px-cols{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:start}
  .px-box{background:var(--paper,#f4f2ec);border-radius:var(--r,14px);padding:22px}
  .px-box h3{margin:0 0 10px;font-size:20px}
  .px-box ul{margin:0;padding:0;list-style:none}
  .px-box li{padding:7px 0;border-bottom:1px solid rgba(0,0,0,.08);display:flex;justify-content:space-between;gap:10px}
  .px-box li:last-child{border:0}
  .px-box b.g{color:#00753d}
  .px-up{display:grid;gap:14px}
  .px-card{display:flex;gap:14px;align-items:center;background:#111;color:#fff;border-radius:var(--r,14px);padding:16px;text-decoration:none}
  .px-card img{width:84px;height:84px;object-fit:contain;flex:0 0 84px;background:#fff;border-radius:10px}
  .px-card .k,.px-card .h,.px-card .s{display:block}
  .px-card .k{font-size:12px;letter-spacing:2px;color:#ff9a3c;font-weight:800;text-transform:uppercase}
  .px-card .h{font-size:18px;font-weight:800;margin:2px 0}
  .px-card .s{font-size:14px;color:#ccc}
  .px-faq details{border-bottom:1px solid rgba(0,0,0,.1);padding:14px 0}
  .px-faq summary{font-weight:700;cursor:pointer;list-style:none}
  .px-faq summary::-webkit-details-marker{display:none}
  .px-faq summary::after{content:'+';float:right;font-weight:400}
  .px-faq details[open] summary::after{content:'–'}
  .px-faq p{margin:10px 0 0;color:var(--muted,#555)}
  @media(max-width:860px){.px-intro,.px-cols{grid-template-columns:1fr}.px-ticks{grid-template-columns:1fr}}
</style>

<section class="px-sec">
  <div class="wrap px-intro{% if imgs == blank %} noimg{% endif %}">
    {%- if imgs != blank -%}
    <div class="px-pics">
      {%- assign first = imgs | first -%}
      <figure><img src="{{ first | image_url: width: 1120 }}" srcset="{{ first | image_url: width: 560 }} 560w, {{ first | image_url: width: 1120 }} 1120w" sizes="(max-width:860px) 100vw, 560px" alt="{{ first.alt | escape }}" loading="lazy" width="{{ first.width }}" height="{{ first.height }}">{%- if first.alt != blank -%}<figcaption>{{ first.alt }}</figcaption>{%- endif -%}</figure>
      {%- if imgs.size > 1 -%}
      <div class="row">
        {%- for im in imgs offset: 1 limit: 2 -%}
        <figure><img src="{{ im | image_url: width: 560 }}" alt="{{ im.alt | escape }}" loading="lazy" width="{{ im.width }}" height="{{ im.height }}"></figure>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
    {%- endif -%}
    <div class="prose rte">
      <span class="eyebrow">Rapid Sticker</span>
      <h2>{{ t }} Sticker: Rapid Pickerl in Premium-Qualität</h2>
      {%- if story != blank -%}{{ story }}{%- endif -%}
      {%- if is_mystery -%}
        <p>15 Rapid Sticker auf einen Schlag, zufällig gemischt, mit Sondermotiven, die’s einzeln nicht gibt. Für den Fanklub, die Auswärtsfahrt oder als Geschenk für den Haberer.</p>
      {%- else -%}
        <p>Gedruckt auf dickem Premium-Vinyl, matt laminiert. Regen, Frost und Sonne halten die Pickerl jahrelang aus, ohne dass das Grün verblasst. Picken kannst du sie auf Laternenmast, Spind, Laptop oder Trinkflasche.</p>
        <p>Jeder Rapid Sticker bei uns hat 9 × 6 cm. Einzeln zahlst du 3,50 €, im eigenen Mix wird jedes Pickerl billiger, bis −20 %.</p>
      {%- endif -%}
      <p>Wir sind Rapid-Fans aus Hütteldorf und verschicken aus Wien, innerhalb von 48 Stunden, knickfrei im Kuvert.</p>
      <ul class="px-ticks">
        <li><b>Dickes Vinyl</b>Matt laminiert, scharfer Druck</li>
        <li><b>Hält jahrelang</b>Wasserfest, frostfest, UV-fest</li>
        <li><b>Aus Wien</b>In 48 h unterwegs, ab 20 € gratis</li>
        <li><b>Von Fans</b>Kurvencode statt Fanshop-Kitsch</li>
      </ul>
    </div>
  </div>
</section>

<section class="px-sec">
  <div class="wrap px-cols">
    <div class="px-box">
      <h3>Rapid Sticker im Mix: je mehr, desto billiger</h3>
      <ul>
        {%- assign tiers = settings.mix_tiers | default: '5:5,10:10,15:12,25:15,50:20' | split: ',' -%}
        {%- for tr in tiers -%}{%- assign p = tr | split: ':' -%}
          {%- assign n = p[0] | plus: 0 -%}{%- assign pc = p[1] | plus: 0 -%}{%- assign keep = 100 | minus: pc -%}
          <li><span>ab {{ n }} Stück</span><span><b class="g">−{{ pc }} %</b> · {{ base | times: keep | divided_by: 100.0 | round | money }}/Stück</span></li>
        {%- endfor -%}
      </ul>
      <p style="margin:12px 0 0;font-size:14px;color:#555">Motive frei mischen, der Rabatt kommt automatisch im Warenkorb.</p>
      <a class="btn btn--g" style="margin-top:14px;width:100%;justify-content:center" href="/pages/mix?n=10">10er Mix zusammenstellen →</a>
    </div>
    <div class="px-up">
      <a class="px-card" href="/pages/mix?n=10">
        <img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title | escape }}" loading="lazy" width="84" height="84">
        <span><span class="k">Spar-Tipp</span><span class="h">{{ t }} im 10er Mix</span><span class="s">10 Pickerl deiner Wahl, −10 %, Versand gratis</span></span>
      </a>
      {%- if mystery != blank and mystery.id != product.id -%}
      <a class="px-card" href="{{ mystery.url }}">
        <img src="{{ mystery.featured_image | image_url: width: 200 }}" alt="{{ mystery.title | escape }}" loading="lazy" width="84" height="84">
        <span><span class="k">Überraschung</span><span class="h">{{ mystery.title }}</span><span class="s">15 zufällige Rapid Sticker um {{ mystery.price | money }}, Versand gratis</span></span>
      </a>
      {%- else -%}
      <a class="px-card" href="/collections/alle-sticker">
        <span><span class="k">Alle Motive</span><span class="h">Selber aussuchen</span><span class="s">Alle Rapid Sticker einzeln ab 3,50 €</span></span>
      </a>
      {%- endif -%}
    </div>
  </div>
</section>

<section class="px-sec">
  <div class="wrap prose px-faq">
    <span class="eyebrow">FAQ</span>
    <h2>{{ t }} Sticker: kurz gefragt</h2>
    <details><summary>Wie lang hält der {{ t }} Sticker draußen?</summary><p>Jahrelang. Dickes Vinyl mit matter Laminierung, wasserfest, frostfest und UV-beständig.</p></details>
    <details><summary>Wie groß ist das Pickerl?</summary><p>9 × 6 cm. Alle Rapid Sticker bei uns haben dasselbe Format und passen im Mix perfekt zusammen.</p></details>
    <details><summary>Wo kann ich Rapid Sticker picken?</summary><p>Auf jeder glatten, sauberen Fläche: Laptop, Trinkflasche, Spind, Koffer, Helm oder Auto. Kurz abwischen, picken, glatt streichen. Bitte nur dort, wo’s erlaubt ist.</p></details>
    <details><summary>Was kostet der Versand?</summary><p>Österreich 2,50 €, Deutschland 3,50 €, ab 20 € gratis. EU und Schweiz 5,00 €. Mindestbestellwert 10 €.</p></details>
    <details><summary>Ist das Fanartikel vom Verein?</summary><p>Nein. Wien West Sticker ist ein unabhängiges Projekt von Rapid-Fans, mit eigenen Designs ohne Vereinswappen.</p></details>
  </div>
</section>

<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
{"@type":"Question","name":{{ 'Wie lang hält der ' | append: t | append: ' Sticker draußen?' | json }},"acceptedAnswer":{"@type":"Answer","text":"Jahrelang. Dickes Vinyl mit matter Laminierung, wasserfest, frostfest und UV-beständig."}},
{"@type":"Question","name":"Wie groß ist das Pickerl?","acceptedAnswer":{"@type":"Answer","text":"9 × 6 cm. Alle Rapid Sticker bei Wien West Sticker haben dasselbe Format."}},
{"@type":"Question","name":"Was kostet der Versand?","acceptedAnswer":{"@type":"Answer","text":"Österreich 2,50 €, Deutschland 3,50 €, ab 20 € gratis. EU und Schweiz 5,00 €."}}
]}
</script>

