<section class="section" style="padding-top:40px">
  <div class="wrap">
    <h2>{{ section.settings.heading }}</h2>
    <div class="grid" id="related">
      {%- assign shown = 0 -%}
      {%- for c in product.collections -%}
        {%- if c.handle == 'alle-sticker' or c.handle == 'einzelsticker' or c.handle == 'bestseller' or c.handle == 'neu' -%}{%- continue -%}{%- endif -%}
        {%- for p in c.products -%}
          {%- if shown >= 4 -%}{%- break -%}{%- endif -%}
          {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
          {%- render 'product-card', product: p -%}
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
        {%- break -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Ähnliche Produkte", "settings": [{ "type": "text", "id": "heading", "label": "Überschrift", "default": "Passt dazu" }] }
{% endschema %}
